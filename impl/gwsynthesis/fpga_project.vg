input PS2_PCLK_d;
input [5:0] PS2_B_d;
input [5:0] PS2_G_d;
input [5:0] PS2_R_d;
output Full;
output Q;
wire VCC;
wire GND;
  \~fifo.ps2_line_fifo  fifo_inst (
    .video_de(video_de),
    .PS2_PCLK_d(PS2_PCLK_d),
    .PS2_B_d(PS2_B_d[5:0]),
    .PS2_G_d(PS2_G_d[5:0]),
