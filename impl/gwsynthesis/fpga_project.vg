    .DI({GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,PS2_R_d[5:1],PS2_G_d[5:0],PS2_B_d[5:1]}),
    .BLKSELA({GND,GND,GND}),
    .BLKSELB({GND,GND,GND}),
    .ADA({pixel_x[9:0],GND,GND,VCC,VCC}),
    .ADB({writeXptr[8:0],GND,GND,GND,GND,GND}),
    .CLKA(PS2_PCLK_d),
    .CLKB(sdram_clk),
    .CEA(n721_3),
    .CEB(fifoRdEn),
    .OCE(VCC),
    .RESETA(n722_6),
    .RESETB(GND) 
);
defparam sdpb_inst_0.BIT_WIDTH_0=16;
defparam sdpb_inst_0.BIT_WIDTH_1=32;
defparam sdpb_inst_0.BLK_SEL_0=3'b000;
defparam sdpb_inst_0.BLK_SEL_1=3'b000;
defparam sdpb_inst_0.READ_MODE=1'b0;
defparam sdpb_inst_0.RESET_MODE="SYNC";
