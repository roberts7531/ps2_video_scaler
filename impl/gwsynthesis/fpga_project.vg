module gw_gao (
  tms_pad_i,
  tck_pad_i,
  tdi_pad_i,
  PS2_PCLK_d,
  PS2_VSYNC_d,
  video_de,
  modedetect_0_1,
  modedetect_1_1,
  modedetect_2_1,
  modedetect_4_1,
  clockEnable,
  PS2_HSYNC_d,
  PS2_R_d,
  h_count,
  pixel_y,
  ceCnt,
  yOffset,
  ySize,
  tdo_pad_o
)
;
input tms_pad_i;
input tck_pad_i;
input tdi_pad_i;
input PS2_PCLK_d;
input PS2_VSYNC_d;
input video_de;
input modedetect_0_1;
input modedetect_1_1;
input modedetect_2_1;
input modedetect_4_1;
input clockEnable;
input PS2_HSYNC_d;
input [5:0] PS2_R_d;
input [15:0] h_count;
input [9:0] pixel_y;
input [0:0] ceCnt;
input [9:0] yOffset;
input [9:0] ySize;
output tdo_pad_o;
wire tms_i_c;
wire tck_i_c;
wire tdi_i_c;
wire tdo_o_c;
wire gao_jtag_tdi;
wire gao_jtag_reset;
wire run_test_idle_er1;
wire run_test_idle_er2;
wire shift_dr_capture_dr;
wire pause_dr;
wire enable_er1;
wire enable_er2;
wire tdo_er1;
wire n12_6;
wire [5:0] control0;
wire [4:2] control0_0;
wire [3:0] module_id_reg;
wire [7:7] control0_1;
wire VCC;
wire GND;
  IBUF tms_ibuf (
    .O(tms_i_c),
    .I(tms_pad_i) 
);
  IBUF tck_ibuf (
    .O(tck_i_c),
    .I(tck_pad_i) 
);
  IBUF tdi_ibuf (
    .O(tdi_i_c),
    .I(tdi_pad_i) 
);
  OBUF tdo_obuf (
    .O(tdo_pad_o),
    .I(tdo_o_c) 
);
//black box: GW_JTAG u_gw_jtag
  GW_JTAG u_gw_jtag (
    .tck_pad_i(tck_i_c),
    .tms_pad_i(tms_i_c),
    .tdi_pad_i(tdi_i_c),
    .tdo_er1_i(tdo_er1),
    .tdo_er2_i(GND),
    .tdo_pad_o(tdo_o_c),
    .tck_o(control0[0]),
    .tdi_o(gao_jtag_tdi),
    .test_logic_reset_o(gao_jtag_reset),
    .run_test_idle_er1_o(run_test_idle_er1),
    .run_test_idle_er2_o(run_test_idle_er2),
    .shift_dr_capture_dr_o(shift_dr_capture_dr),
    .pause_dr_o(pause_dr),
    .update_dr_o(control0[5]),
    .enable_er1_o(enable_er1),
    .enable_er2_o(enable_er2) 
);
  gw_con_top u_icon_top (
    .shift_dr_capture_dr(shift_dr_capture_dr),
    .enable_er1(enable_er1),
    .gao_jtag_tdi(gao_jtag_tdi),
    .gao_jtag_reset(gao_jtag_reset),
    .control0(control0_1[7]),
    .control0_0_1(control0[0]),
    .control0_5(control0[5]),
    .tdo_er1(tdo_er1),
    .n12_6(n12_6),
    .control0_2_3(control0_0[2]),
    .control0_4(control0_0[4]),
    .module_id_reg(module_id_reg[3:0])
);
  ao_top_0 u_la0_top (
    .n12_6(n12_6),
    .PS2_PCLK_d(PS2_PCLK_d),
    .shift_dr_capture_dr(shift_dr_capture_dr),
    .PS2_VSYNC_d(PS2_VSYNC_d),
    .video_de(video_de),
    .modedetect_0_1(modedetect_0_1),
    .modedetect_1_1(modedetect_1_1),
    .modedetect_2_1(modedetect_2_1),
    .modedetect_4_1(modedetect_4_1),
    .clockEnable(clockEnable),
    .PS2_HSYNC_d(PS2_HSYNC_d),
    .control0_2(control0_0[2]),
    .control0_4(control0_0[4]),
    .control0_0(control0[0]),
    .control0_5_6(control0[5]),
    .module_id_reg(module_id_reg[3:0]),
    .PS2_R_d(PS2_R_d[5:0]),
    .h_count(h_count[15:0]),
    .pixel_y(pixel_y[9:0]),
    .ceCnt(ceCnt[0]),
    .yOffset(yOffset[9:0]),
    .ySize(ySize[9:0]),
    .control0_7(control0_1[7])
);
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
endmodule /* gw_gao */
